@page "/login"
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@inject SignInManager<IdentityUser> SignInManager
@inject NavigationManager NavigationManager

<PageTitle>Log in</PageTitle>

<section class="auth-page">
    <div class="auth-intro">
        <p class="eyebrow">Welcome back</p>
        <h1>Return to your collection.</h1>
        <p>Sign in to keep your favorite anime finds close at hand.</p>
    </div>

    <EditForm class="auth-form" Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="auth-field">
            <label for="login-email">Email</label>
            <InputText id="login-email" @bind-Value="Input.Email" />
        </div>
        <div class="auth-field">
            <label for="login-password">Password</label>
            <InputText id="login-password" type="password" @bind-Value="Input.Password" />
        </div>

        <button class="auth-submit" type="submit">Log in <span aria-hidden="true">-&gt;</span></button>

        @if (loginFailed)
        {
            <p class="auth-error">Invalid login attempt.</p>
        }
    </EditForm>
</section>

@code {
    [SupplyParameterFromForm]
    public InputModel Input { get; set; } = new();

    private bool loginFailed = false;

    private async Task LoginUser()
    {
        var result = await SignInManager.PasswordSignInAsync(
            Input.Email, Input.Password, isPersistent: false, lockoutOnFailure: false);

        if (result.Succeeded)
        {
            NavigationManager.NavigateTo("/");
        }
        else
        {
            loginFailed = true;
        }
    }

    public class InputModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}