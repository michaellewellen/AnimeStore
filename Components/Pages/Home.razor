@page "/"

<PageTitle>Home</PageTitle>

<section class="storefront-hero">
    <div class="hero-copy">
        <p class="eyebrow">Curated for collectors</p>
        <h1>Small treasures.<br />Big anime energy.</h1>
        <p class="hero-description">Discover playful figures, paper art, and desk-side favorites for your next collection.</p>
    </div>
</section>

<div class="storefront-search">
    <label for="product-search">Search the collection</label>
    <div class="search-field">
        <span aria-hidden="true">⌕</span>
        <input id="product-search" type="text" placeholder="Search for products..." />
    </div>
</div>

<section class="featured-section">
    <div class="section-heading">
        <div>
            <p class="eyebrow">The good stuff</p>
            <h2>Featured products</h2>
        </div>
        <span class="section-note">Fresh picks for your shelf</span>
    </div>

    <div class="product-grid">
        <article class="product-card">
            <div class="product-image product-image-anime"><span>FIGURE 01</span></div>
            <div class="product-details">
                <p class="product-category">Anime collectibles</p>
                <h3>Moonlit Hero Figure</h3>
                <p class="product-price">$24.99</p>
                <button type="button">Add to cart <span aria-hidden="true">+</span></button>
            </div>
        </article>

        <article class="product-card">
            <div class="product-image product-image-anime-alt"><span>FIGURE 02</span></div>
            <div class="product-details">
                <p class="product-category">Anime collectibles</p>
                <h3>Spirit Fox Companion</h3>
                <p class="product-price">$18.50</p>
                <button type="button">Add to cart <span aria-hidden="true">+</span></button>
            </div>
        </article>

        <article class="product-card">
            <div class="product-image product-image-origami"><span>ORIGAMI 01</span></div>
            <div class="product-details">
                <p class="product-category">Origami</p>
                <h3>Origami Crane Set</h3>
                <p class="product-price">$1.99</p>
                <button type="button">Add to cart <span aria-hidden="true">+</span></button>
            </div>
        </article>

        <article class="product-card">
            <div class="product-image product-image-origami-alt"><span>ORIGAMI 02</span></div>
            <div class="product-details">
                <p class="product-category">Origami</p>
                <h3>Sunset Paper Garden</h3>
                <p class="product-price">$8.75</p>
                <button type="button">Add to cart <span aria-hidden="true">+</span></button>
            </div>
        </article>
    </div>
</section>

