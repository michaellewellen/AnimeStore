@page "/register"
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@using AnimeStore.Data
@inject UserManager<IdentityUser> UserManager
@inject SignInManager<IdentityUser> SignInManager
@inject NavigationManager NavigationManager

<PageTitle>Register</PageTitle>

<section class="auth-page">
    <div class="auth-intro">
        <p class="eyebrow">Join the club</p>
        <h1>Make room for more joy.</h1>
        <p>Create an account to start building your anime collection.</p>
    </div>

    <EditForm class="auth-form" Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="auth-field">
            <label for="register-email">Email</label>
            <InputText id="register-email" @bind-Value="Input.Email" />
        </div>
        <div class="auth-field">
            <label for="register-password">Password</label>
            <InputText id="register-password" type="password" @bind-Value="Input.Password" />
        </div>

        <button class="auth-submit" type="submit">Register <span aria-hidden="true">-&gt;</span></button>
        @if (errors.Any())
        {
            <ul class="auth-error-list">
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        }
    </EditForm>
</section>

@code {
    [SupplyParameterFromForm]
    public InputModel Input { get; set; } = new();

    private async Task RegisterUser()
    {
        var user = new IdentityUser
        {
            UserName = Input.Email,
            Email = Input.Email
        };

        var result = await UserManager.CreateAsync(user, Input.Password);

        if (result.Succeeded)
        {
            await SignInManager.SignInAsync(user, isPersistent: false);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            errors = result.Errors.Select(e => e.Description).ToList();
        }
    }
    private List<string> errors = new();
    public class InputModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}