@page "/cart"
@rendermode InteractiveServer
@using AnimeStore.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject GuestCartService GuestCartService
@inject NavigationManager NavigationManager

<PageTitle>Cart</PageTitle>

@if (cart is null)
{
    <p>Loading your cart...</p>
}
else
{
    <section class="cart-page">
        <div class="cart-items">
            @foreach (var item in cart.Items.Where(i => !i.IsSavedForLater))
            {
                <article class="cart-item">
                    <div class="cart-item-image">
                        <img src="@item.ProductVariant.Product.Images.OrderBy(img => img.DisplayOrder).FirstOrDefault()?.ImagePath"
                             alt="@item.ProductVariant.Product.ShortName" style="width:80px;" />
                    </div>
                    <div class="cart-item-details">
                        <h3>@item.ProductVariant.Product.ShortName</h3>
                        <p>@item.ProductVariant.ProductSize @item.ProductVariant.ProductColor</p>
                        <button @onclick="() => SaveForLater(item)">Save for later</button>
                        <button @onclick="() => RemoveItem(item)">Remove</button>
                    </div>
                    <div class="cart-item-actions">
                        <button @onclick="() => ChangeQuantity(item, -1)">−</button>
                        <span>@item.Quantity</span>
                        <button @onclick="() => ChangeQuantity(item, 1)">+</button>
                        <strong>@((item.Quantity * item.ProductVariant.RetailPrice).ToString("C"))</strong>
                    </div>
                </article>
            }
        </div>

        @if (cart.Items.Any(i => i.IsSavedForLater))
        {
            <h2>Saved for later</h2>
            @foreach (var item in cart.Items.Where(i => i.IsSavedForLater))
            {
                <article class="cart-item">
                    <h3>@item.ProductVariant.Product.ShortName</h3>
                    <button @onclick="() => MoveToCart(item)">Move to cart</button>
                    <button @onclick="() => RemoveItem(item)">Remove</button>
                </article>
            }
        }

        <aside class="order-summary">
            <div><span>Subtotal</span><strong>@SubTotal.ToString("C")</strong></div>
            <div><span>Shipping</span><strong>@ShippingCost.ToString("C")</strong></div>
            <div><span>Estimated tax</span><strong>@TaxAmount.ToString("C")</strong></div>
            <div class="summary-total"><span>Total</span><strong>@OrderTotal.ToString("C")</strong></div>

            <button @onclick="ProceedToCheckout" disabled="@(!cart.Items.Any(i => !i.IsSavedForLater))">
                Continue to checkout
            </button>
        </aside>
    </section>
}

@code {
    private Data.Cart? cart;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var guestToken = await GuestCartService.GetOrCreateGuestTokenAsync();
            cart = await GuestCartService.GetOrCreateCurrentCartAsync(guestToken);
            StateHasChanged();
        }
    }

    private decimal SubTotal => cart!.Items.Where(i => !i.IsSavedForLater)
        .Sum(i => i.Quantity * i.ProductVariant.RetailPrice);

    private decimal ShippingCost => 10.00m;
    private decimal TaxAmount => PricingCalculator.CalculateTax(SubTotal);
    private decimal OrderTotal => SubTotal + ShippingCost + TaxAmount;

    private async Task ChangeQuantity(CartItem item, int delta)
    {
        item.Quantity = Math.Max(1, item.Quantity + delta);
        await DbContext.SaveChangesAsync();
    }

    private async Task RemoveItem(CartItem item)
    {
        DbContext.CartItems.Remove(item);
        cart!.Items.Remove(item);
        await DbContext.SaveChangesAsync();
    }

    private async Task SaveForLater(CartItem item)
    {
        item.IsSavedForLater = true;
        await DbContext.SaveChangesAsync();
    }

    private async Task MoveToCart(CartItem item)
    {
        item.IsSavedForLater = false;
        await DbContext.SaveChangesAsync();
    }

    private void ProceedToCheckout()
    {
        NavigationManager.NavigateTo("/checkout");
    }
}